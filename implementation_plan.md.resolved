## Database Schema (MongoDB Collections)

### Users
```js
{
  name, email, phone, password (hashed),
  role: "customer" | "tailor" | "admin",
  avatar, location: { city, state, coordinates },
  isVerified: Boolean,
  createdAt, updatedAt
}
```

### TailorProfiles
```js
{
  userId (ref → Users),
  bio, specializations: [String],
  experience: Number (years),
  serviceArea: [String],
  startingPrices: { shirt: 500, kurta: 800, ... },
  portfolio: [{ imageUrl, caption }],
  verificationStatus: "pending" | "approved" | "rejected",
  verificationDocs: [String] (Cloudinary URLs),
  averageRating, totalReviews,
  isActive: Boolean
}
```

### Products (catalog/categories)
```js
{
  name, category: "men" | "women" | "kids",
  subCategory: "ethnic" | "western",
  type: "shirt" | "kurta" | "lehenga" | ...,
  designOptions: { collarTypes: [...], sleeveStyles: [...], ... },
  measurementTemplate: String (ref),
  baseImage, description
}
```

### Orders
```js
{
  customerId, tailorId,
  product: { type, designChoices, referenceImages },
  measurements: { chest, waist, ... },
  measurementProfileName: String,
  fabricPreference, specialInstructions,
  deliveryAddress, deliveryType: "shipping" | "self-pickup",
  status: "placed" | "accepted" | "rejected" | "in_progress" | "shipped" | "delivered" | "disputed",
  quotedPrice, advancePaid, balancePaid,
  trackingNumber, estimatedDelivery,
  razorpayOrderId, razorpayPaymentId,
  createdAt, updatedAt
}
```

### Reviews
```js
{
  customerId, tailorId, orderId,
  rating: 1-5, text,
  photos: [String],
  isFlagged: Boolean,
  createdAt
}
```

### Messages
```js
{
  orderId, senderId, receiverId,
  content, imageUrl,
  isRead: Boolean,
  createdAt
}
```

### MeasurementProfiles
```js
{
  userId, profileName: "Self" | "Mom" | ...,
  garmentType,
  measurements: { chest, waist, hip, ... }
}
```

### Disputes
```js
{
  orderId, raisedBy (customerId),
  reason, description, evidencePhotos: [String],
  status: "open" | "resolved" | "refunded",
  adminNotes, resolvedAt
}
```

